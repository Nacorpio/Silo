{
  // The look of the Controls of Silo.Controls.Agents. Load it after the default theme.
  "rules": {
    "ToolCallCard": {
      "flex-direction": "column",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
    },
    "ToolCallCard:running": { "border-color": "var(--accent)" },
    "ToolCallCard:failed": { "border-color": "#ef4444" },
    "ToolCallCard:waiting": { "border-color": "#f59e0b" },
    "ToolCallCard .header": {
      "flex-direction": "row",
      "align-items": "center",
      "gap": "8px",
      "padding": "6px 8px",
      "&:hover": { "background": "var(--track)" },
      "&:focus": { "background": "var(--track)" },
    },
    "ToolCallCard .chevron": { "width": "12px", "height": "12px", "color": "var(--muted)" },
    "ToolCallCard Icon.status": { "width": "16px", "height": "16px", "color": "var(--muted)" },
    "ToolCallCard:succeeded Icon.status": { "color": "#16a34a" },
    "ToolCallCard:failed Icon.status": { "color": "#ef4444" },
    "ToolCallCard:waiting Icon.status": { "color": "#f59e0b" },
    "ToolCallCard ProgressRing.status": { "width": "16px", "height": "16px", "ring-thickness": "2px" },
    "ToolCallCard .name": { "font-family": "var(--font-mono)", "font-size": "13px" },
    "ToolCallCard .summary": {
      "flex-grow": 1,
      "flex-basis": "0px",
      "min-width": "0px",
      "color": "var(--muted)",
      "font-size": "13px",
    },
    "ToolCallCard .duration": { "color": "var(--muted)", "font-size": "12px" },
    "ToolCallCard .action": {
      "padding": "2px 8px",
      "font-size": "12px",
      "background": "transparent",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "ToolCallCard .body": {
      "flex-direction": "column",
      "gap": "4px",
      "align-items": "stretch",
      "padding": "6px 8px 8px 8px",
      "border-width": "0px",
    },
    "ToolCallCard .label": { "color": "var(--muted)", "font-size": "11px" },
    "ToolCallCard TextArea.arguments": { "width": "100%", "height": "84px", "font-family": "var(--font-mono)", "font-size": "12px", "padding": "4px 6px" },
    "ToolCallCard TextArea.output": { "width": "100%", "height": "144px", "font-family": "var(--font-mono)", "font-size": "12px", "padding": "4px 6px" },
    "ToolCallCard .error": { "color": "#ef4444", "font-size": "12px" },
    "ToolCallCard:waiting .error": { "color": "#f59e0b" },
    "ToolCallCard .copy": {
      "padding": "2px 8px",
      "font-size": "12px",
      "background": "transparent",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "&:hover": { "background": "var(--track)" },
    },
    "ToolCallCard .meta": { "color": "var(--muted)", "font-family": "var(--font-mono)", "font-size": "11px" },
    "ToolCallCard.density-compact .header": { "gap": "6px", "padding": "2px 6px" },
    "ToolCallCard.density-compact .body": { "gap": "2px", "padding": "4px 6px 6px 6px" },
    "ToolCallCard.density-roomy .header": { "gap": "10px", "padding": "10px 12px" },
    "ToolCallCard.density-roomy .body": { "gap": "8px", "padding": "10px 12px 12px 12px" },
    "ToolCallTimeline": { "flex-direction": "column", "gap": "8px" },
    "ToolCallTimeline.density-compact": { "gap": "3px" },
    "ToolCallTimeline.density-roomy": { "gap": "12px" },
    "ToolCallTimeline.density-compact ToolCallGroup": { "gap": "3px" },
    "ToolCallTimeline.density-roomy ToolCallGroup": { "gap": "12px" },
    "ToolCallTimeline.density-compact ToolCallGroup .children": { "gap": "3px" },
    "ToolCallTimeline.density-roomy ToolCallGroup .children": { "gap": "12px" },
    "ToolCallTimeline .summary": { "color": "var(--muted)", "font-size": "12px", "padding": "0px 2px" },
    "ToolCallGroup": { "flex-direction": "column", "gap": "8px", "border-color": "var(--border)" },
    "ToolCallGroup .children": { "flex-direction": "column", "gap": "8px", "padding": "0px 0px 0px 18px" },
  },
}

{
  // The look of the Controls of Silo.Controls.Chat. Load it after the default theme.
  "rules": {
    "MessageBubble": {
      "flex-direction": "row",
      "align-items": "flex-start",
      "gap": "8px",
      "padding": "4px 8px",
      "color": "var(--text)",
    },
    "MessageBubble.aligned": { "justify-content": "flex-end" },
    "MessageBubble Avatar.avatar": { "width": "32px", "height": "32px" },
    "MessageBubble .avatar-space": { "width": "32px", "height": "1px" },
    "MessageBubble .content": { "flex-direction": "column", "gap": "2px", "max-width": "520px", "flex-shrink": 1 },
    "MessageBubble .header": { "flex-direction": "row", "align-items": "center", "gap": "8px" },
    "MessageBubble .author": { "font-weight": "600" },
    "MessageBubble .time": { "color": "var(--muted)", "font-size": "11px" },
    "MessageBubble TextArea.text": {
      "background": "transparent",
      "border-width": "0px",
      "padding": "0px",
      "color": "var(--text)",
    },
    "MessageBubble .attachments": { "flex-direction": "row", "gap": "6px" },
    "MessageBubble .attachment": {
      "padding": "2px 8px",
      "background": "var(--track)",
      "border-radius": "var(--radius)",
      "font-size": "12px",
    },
    "MessageBubble .footer": { "flex-direction": "row", "align-items": "center", "gap": "8px", "justify-content": "flex-end" },
    "MessageBubble .status": { "color": "var(--muted)", "font-size": "11px" },
    "MessageBubble:failed .status": { "color": "#ef4444" },
    "MessageBubble .retry": {
      "padding": "1px 8px",
      "background": "transparent",
      "color": "#ef4444",
      "border-width": "1px",
      "border-color": "#ef4444",
      "font-size": "11px",
    },
    "MessageBubble.system": { "justify-content": "center" },
    "MessageBubble.system .content": { "max-width": "100%" },
    "MessageBubble.system TextArea.text": { "color": "var(--muted)", "font-size": "12px" },
    "MessageBubble.style-bubble .content": {
      "padding": "6px 10px",
      "background": "var(--track)",
      "border-radius": "12px",
    },
    "MessageBubble.style-bubble.own .content": { "background": "var(--accent)", "color": "var(--accent-text)" },
    "MessageBubble.style-bubble.own TextArea.text": { "color": "var(--accent-text)", "selection-color": "#ffffff66" },
    "MessageBubble TextArea.text": { "selection-color": "var(--accent)" },
    "MessageBubble.style-bubble.own .time": { "color": "var(--accent-text)" },
    "MessageBubble.style-bubble.own .status": { "color": "var(--accent-text)" },
    "MessageBubble.style-bubble.own:failed .content": { "background": "#ef4444" },
    "MessageBubble.own:failed .status": { "color": "var(--accent-text)" },
    "MessageBubble.own:failed .retry": { "color": "var(--accent-text)", "border-color": "var(--accent-text)" },
    "MessageBubble.style-bubble.system .content": { "background": "transparent" },
    "MessageBubble.style-flat.own .content": { "padding": "0px" },
    "MessageBubble.style-lines": { "padding": "1px 8px", "gap": "0px" },
    "MessageBubble.style-lines .content": { "flex-direction": "row", "gap": "8px", "max-width": "100%", "flex-grow": 1 },
    "MessageBubble.style-lines TextArea.text": { "flex-grow": 1 },
    "MessageBubble.style-lines .author": { "color": "var(--accent)" },
    "MessageBubble.density-compact": { "padding": "2px 6px", "gap": "6px" },
    "MessageBubble.density-roomy": { "padding": "10px 14px", "gap": "12px" },
    "MessageBubble.density-compact .content": { "gap": "0px" },
    "MessageBubble.density-roomy .content": { "gap": "5px" },
    "ChatInput": {
      "flex-direction": "column",
      "gap": "6px",
      "padding": "8px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
    },
    "ChatInput .context": {
      "flex-direction": "row",
      "align-items": "center",
      "gap": "8px",
      "padding": "4px 8px",
      "background": "var(--track)",
      "border-radius": "var(--radius)",
    },
    "ChatInput .context-text": { "flex-grow": 1, "color": "var(--muted)", "font-size": "12px" },
    "ChatInput .close": {
      "padding": "0px 6px",
      "background": "transparent",
      "color": "var(--muted)",
      "&:hover": { "color": "var(--text)" },
    },
    "ChatInput .attachments": { "flex-direction": "row", "gap": "6px" },
    "ChatInput .row": { "flex-direction": "row", "align-items": "flex-end", "gap": "8px" },
    "ChatInput TextArea.composer": { "flex-grow": 1 },
    "ChatInput .send": {
      "background": "var(--accent)",
      "color": "var(--accent-text)",
      "padding": "6px 14px",
      "&:hover": { "background": "var(--accent-hover)" },
    },
    "ChatInput.density-compact": { "gap": "3px", "padding": "4px" },
    "ChatInput.density-roomy": { "gap": "10px", "padding": "14px" },
    "ChatInput.density-compact .send": { "padding": "3px 10px" },
    "ChatInput.density-roomy .send": { "padding": "9px 18px" },
  },
}

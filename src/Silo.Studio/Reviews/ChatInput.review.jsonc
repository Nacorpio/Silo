{
  // Questions for the soft wrap of the message composer.
  "control": "ChatInput",
  "title": "ChatInput soft wrap review",
  "pr": "Silo: TextArea soft wrap (WordWrap), on in ChatInput",
  "questions": [
    { "id": "wrap", "kind": "yesno", "prompt": "Do long lines wrap at spaces, with no sideways scrolling?", "variant": "Long text" },
    { "id": "word", "kind": "yesno", "prompt": "Is the very long word broken inside the word, and only that word?", "variant": "Long text" },
    { "id": "grow", "kind": "yesno", "prompt": "Does the box grow with the wrapped rows, up to the maximum, and then scroll?", "hint": "Type a long paragraph.", "variant": "Long text" },
    { "id": "caret", "kind": "yesno", "prompt": "Do Up, Down, Home and End move by wrapped row and keep the column?", "hint": "Click in the text and try the keys.", "variant": "Long text" },
    { "id": "look", "kind": "rating", "prompt": "How does the wrapped text look overall?" },
    { "id": "missing", "kind": "text", "prompt": "What is missing or feels wrong?" }
  ]
}

{
  // The dark variant of the default Silo theme. It only overrides Tokens, so it is loaded after default.jsonc and
  // every rule there picks up the new colors.
  "tokens": {
    "--surface": "#111827",
    "--text": "#f3f4f6",
    "--border": "#4b5563",
    "--track": "#374151",
    "--skeleton-shine": "#ffffff1a",
    "--muted": "#6b7280",
    "--tooltip": "#374151",
    "--tooltip-text": "#f9fafb",
    "--tooltip-muted": "#9ca3af",
    "--scrim": "#111827cc",
  },
}

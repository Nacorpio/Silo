{
  // The default Silo theme. Everything a Control looks like comes from the Tokens below, so a derived theme can
  // restyle the whole library by overriding them.
  "tokens": {
    "--font-family": "Segoe UI, Inter, Helvetica, Arial, sans-serif",
    "--font-mono": "Fira Code, Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace",
    "--font-size": "14px",
    "--surface": "#ffffff",
    "--text": "#1f2937",
    "--accent": "#3b82f6",
    "--accent-hover": "#2563eb",
    "--accent-active": "#1d4ed8",
    "--accent-text": "#ffffff",
    "--radius": "4px",
    "--border": "#9ca3af",
    "--track": "#e5e7eb",
    "--tooltip": "#1f2937",
    "--tooltip-text": "#f9fafb",
    "--tooltip-muted": "#9ca3af",
    "--muted": "#9ca3af",
  },
  "rules": {
    "Box": {
      "color": "var(--text)",
      "font-family": "var(--font-family)",
      "font-size": "var(--font-size)",
    },
    "Window": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "font-family": "var(--font-family)",
      "font-size": "var(--font-size)",
      "flex-direction": "column",
    },
    "TextBlock": { "color": "var(--text)" },
    "Separator": { "background": "var(--border)", "height": "1px", "&.vertical": { "width": "1px", "height": "auto" } },
    "Expander": { "color": "var(--text)", "flex-direction": "column", "gap": "4px" },
    "ExpanderHeader": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "4px 4px 4px 20px",
      "text-align": "left",
      "indicator-color": "var(--muted)",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "TabView": { "color": "var(--text)", "flex-direction": "column" },
    "TabStrip": { "flex-direction": "row", "gap": "2px", "background": "var(--border)", "padding": "0 0 1px 0" },
    "TabHeader": {
      "background": "var(--track)",
      "color": "var(--muted)",
      "padding": "6px 12px",
      "flex-direction": "row",
      "align-items": "center",
      "gap": "8px",
      "icon-position": "left",
      "icon-size": "16px",
      "icon-gap": "6px",
      "button-position": "right",
      "&:hover": { "background": "var(--border)" },
      "&:selected": { "color": "var(--text)", "background": "var(--surface)" },
    },
    "TabHeaderButton": {
      "color": "var(--muted)",
      "padding": "0 4px",
      "&:hover": { "color": "var(--text)", "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Dialog": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "flex-direction": "column",
      "gap": "12px",
      "padding": "16px",
      "min-width": "280px",
      "backdrop-color": "#00000066",
      "dismiss-on-outside-press": "false",
    },
    "DialogTitle": { "font-weight": "bold", "font-size": "16px" },
    "DialogButtons": { "flex-direction": "row", "justify-content": "end", "gap": "8px" },
    "MenuBar": { "flex-direction": "row", "background": "var(--surface)", "color": "var(--text)" },
    "MenuBarItem": {
      "color": "var(--text)",
      "padding": "4px 10px",
      "&:hover": { "background": "var(--track)" },
      "&:open": { "background": "var(--border)" },
    },
    "Toolbar": {
      "flex-direction": "row",
      "align-items": "stretch",
      "gap": "2px",
      "padding": "3px 4px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "0 0 1px 0",
      "border-color": "var(--border)",
    },
    "Toolbar Button": {
      "background": "transparent",
      "color": "var(--text)",
      "padding": "4px 10px",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Toolbar Separator": { "margin": "2px 4px" },
    "Button": {
      "background": "var(--accent)",
      "color": "var(--accent-text)",
      "padding": "6px 12px",
      "border-radius": "var(--radius)",
      "text-align": "center",
      "&:hover": { "background": "var(--accent-hover)" },
      "&:active": { "background": "var(--accent-active)" },
    },
    "DatePicker": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "placeholder-color": "var(--muted)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "Calendar": {
      "flex-direction": "column",
      "gap": "2px",
      "padding": "8px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "&:focus": { "border-color": "var(--accent)" },
    },
    "Calendar .header": { "flex-direction": "row", "align-items": "center", "gap": "4px" },
    "Calendar .title": { "flex-grow": "1", "text-align": "center", "color": "var(--text)" },
    "Calendar .nav": {
      "background": "transparent",
      "color": "var(--text)",
      "padding": "2px 8px",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Calendar .weekdays": { "flex-direction": "row" },
    "Calendar .weekday": { "width": "30px", "text-align": "center", "color": "var(--muted)", "font-size": "11px" },
    "Calendar .week": { "flex-direction": "row" },
    "Calendar .day": {
      "width": "30px",
      "padding": "4px 0",
      "background": "transparent",
      "color": "var(--text)",
      "text-align": "center",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Calendar .day.outside": { "color": "var(--muted)" },
    "Calendar .day.today": { "border-width": "1px", "border-color": "var(--accent)" },
    "Calendar .day.cursor": { "border-width": "1px", "border-color": "var(--accent-hover)" },
    "Calendar .day.selected": {
      "background": "var(--accent)",
      "color": "var(--accent-text)",
      "&:hover": { "background": "var(--accent-hover)" },
    },
    "Calendar .day.disabled": { "color": "var(--border)", "&:hover": { "background": "transparent" } },
    "ColorPicker": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "ColorPanel": {
      "flex-direction": "column",
      "gap": "8px",
      "width": "200px",
      "padding": "8px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
    },
    "ColorPanel .square": { "height": "110px", "border-width": "1px", "border-color": "var(--border)" },
    "ColorPanel .hue": { "height": "14px", "border-width": "1px", "border-color": "var(--border)" },
    "ColorPanel .alpha": { "height": "14px", "border-width": "1px", "border-color": "var(--border)" },
    "ColorPanel .square:focus": { "border-color": "var(--accent)" },
    "ColorPanel .hue:focus": { "border-color": "var(--accent)" },
    "ColorPanel .alpha:focus": { "border-color": "var(--accent)" },
    "DataGrid": {
      "height": "160px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "header-background": "var(--track)",
      "header-color": "var(--text)",
      "grid-color": "var(--border)",
      "hover-color": "var(--track)",
      "selection-color": "var(--accent)",
      "selection-text-color": "var(--accent-text)",
      "&:focus": { "border-color": "var(--accent)" },
    },
    "ToastHost": { "flex-direction": "column", "gap": "8px", "padding": "12px" },
    "Toast": {
      "flex-direction": "row",
      "align-items": "center",
      "gap": "10px",
      "width": "320px",
      "padding": "10px 12px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--accent)",
      "border-radius": "var(--radius)",
    },
    "Toast.success": { "border-color": "#22c55e" },
    "Toast.warning": { "border-color": "#f59e0b" },
    "Toast.error": { "border-color": "#ef4444" },
    "Toast .body": { "flex-direction": "column", "flex-grow": "1", "min-width": "0px" },
    "Toast .title": { "font-weight": "bold" },
    "Toast .message": { "color": "var(--text)" },
    "Toast .action": {
      "background": "transparent",
      "color": "var(--accent)",
      "padding": "4px 8px",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Toast .close": {
      "background": "transparent",
      "color": "var(--muted)",
      "padding": "2px 8px",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Label": { "color": "var(--text)" },
    "Badge": {
      "padding": "1px 7px",
      "background": "var(--track)",
      "color": "var(--text)",
      "border-radius": "999px",
      "font-size": "11px",
      "font-weight": "bold",
      "text-align": "center",
    },
    "Badge.info": { "background": "var(--accent)", "color": "var(--accent-text)" },
    "Badge.success": { "background": "#16a34a", "color": "#ffffff" },
    "Badge.warning": { "background": "#f59e0b", "color": "#1f2937" },
    "Badge.error": { "background": "#dc2626", "color": "#ffffff" },
    "Avatar": {
      "width": "36px",
      "height": "36px",
      "color": "#ffffff",
      "border-radius": "999px",
      "font-size": "14px",
      "font-weight": "bold",
    },
    "Icon": { "color": "var(--text)" },
    "GroupBox": {
      "flex-direction": "column",
      "gap": "8px",
      "padding": "10px 12px",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
    },
    "GroupBox .header": { "color": "var(--muted)", "font-weight": "bold" },
    "Card": {
      "flex-direction": "column",
      "gap": "10px",
      "padding": "14px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
    },
    "Card .header": { "font-weight": "bold" },
    "Card .footer": { "color": "var(--muted)" },
    "HyperlinkButton": {
      "background": "transparent",
      "color": "var(--accent)",
      "padding": "2px 4px",
      "text-align": "left",
      "&:hover": { "background": "transparent", "color": "var(--accent-hover)" },
      "&:active": { "background": "transparent", "color": "var(--accent-active)" },
      "&:visited": { "color": "var(--muted)" },
    },
    "InfoBar": {
      "flex-direction": "row",
      "align-items": "center",
      "gap": "10px",
      "padding": "10px 12px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--accent)",
      "border-radius": "var(--radius)",
    },
    "InfoBar.success": { "border-color": "#22c55e" },
    "InfoBar.warning": { "border-color": "#f59e0b" },
    "InfoBar.error": { "border-color": "#ef4444" },
    "InfoBar.closed": { "padding": "0px", "border-width": "0px" },
    "InfoBar .body": { "flex-direction": "column", "flex-grow": "1", "min-width": "0px" },
    "InfoBar .title": { "font-weight": "bold" },
    "InfoBar .message": { "color": "var(--text)" },
    "InfoBar .action": {
      "background": "transparent",
      "color": "var(--accent)",
      "padding": "4px 8px",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "InfoBar .close": {
      "background": "transparent",
      "color": "var(--muted)",
      "padding": "2px 8px",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "SegmentedControl": { "flex-direction": "row", "gap": "0px", "color": "var(--text)" },
    "SegmentedControl .segment": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 14px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "0px",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "SegmentedControl .selected": { "background": "var(--accent)", "color": "var(--accent-text)", "border-color": "var(--accent)" },
    "RadioGroup": { "flex-direction": "column", "gap": "6px", "color": "var(--text)" },
    "Rating": { "rating-color": "#f59e0b", "rating-empty-color": "var(--muted)", "icon-size": "20px", "rating-gap": "4px" },
    "RangeSlider": { "height": "24px", "slider-track-color": "var(--track)", "slider-fill-color": "var(--accent)", "slider-thumb-color": "#ffffff" },
    "FormField": { "flex-direction": "column", "gap": "4px", "color": "var(--text)" },
    "FormField .label": { "font-weight": "bold" },
    "FormField .help": { "color": "var(--muted)", "font-size": "12px" },
    "ValidationMessage": { "color": "#ef4444", "font-size": "12px" },
    "FormField.invalid TextBox": { "border-color": "#ef4444" },
    "Breadcrumb": { "flex-direction": "row", "align-items": "center", "gap": "4px", "color": "var(--text)" },
    "Breadcrumb .current": { "font-weight": "bold", "color": "var(--text)" },
    "Breadcrumb .separator": { "icon-size": "12px", "color": "var(--muted)" },
    "Breadcrumb .ellipsis": { "color": "var(--muted)" },
    "Pager": { "flex-direction": "row", "align-items": "center", "gap": "4px", "color": "var(--text)" },
    "Pager .page": {
      "background": "transparent",
      "color": "var(--text)",
      "padding": "4px 10px",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Pager .current": { "background": "var(--accent)", "color": "var(--accent-text)", "&:hover": { "background": "var(--accent-hover)" } },
    "Pager .prev": { "background": "transparent", "color": "var(--text)", "padding": "4px 10px", "&:hover": { "background": "var(--track)" } },
    "Pager .next": { "background": "transparent", "color": "var(--text)", "padding": "4px 10px", "&:hover": { "background": "var(--track)" } },
    "Pager .disabled": { "color": "var(--muted)", "&:hover": { "background": "transparent" } },
    "Pager .ellipsis": { "color": "var(--muted)" },
    "Accordion": { "flex-direction": "column", "gap": "4px", "color": "var(--text)" },
    "StatusBar": {
      "flex-direction": "row",
      "align-items": "center",
      "gap": "12px",
      "padding": "3px 10px",
      "background": "var(--surface)",
      "color": "var(--muted)",
      "font-size": "12px",
      "border-width": "1px",
      "border-color": "var(--border)",
    },
    "StatusBar .left": { "flex-direction": "row", "gap": "12px", "align-items": "center", "flex-grow": "1" },
    "StatusBar .center": { "flex-direction": "row", "gap": "12px", "align-items": "center", "justify-content": "center" },
    "StatusBar .right": { "flex-direction": "row", "gap": "12px", "align-items": "center", "justify-content": "end", "flex-grow": "1" },
    "StatusBar .item": { "color": "var(--muted)" },
    "NavigationView": { "flex-direction": "row", "color": "var(--text)" },
    "NavigationView .pane": {
      "flex-direction": "column",
      "gap": "2px",
      "width": "220px",
      "flex-shrink": "0",
      "padding": "8px",
      "background": "var(--surface)",
      "border-width": "1px",
      "border-color": "var(--border)",
    },
    "NavigationView.compact .pane": { "width": "56px" },
    "NavigationView .content": { "flex-direction": "column", "flex-grow": "1", "min-width": "0px", "padding": "12px" },
    "NavigationView .header": { "color": "var(--muted)", "font-size": "12px", "font-weight": "bold", "padding": "10px 8px 4px 8px" },
    "NavigationView .item": {
      "background": "transparent",
      "color": "var(--text)",
      "padding": "8px 8px 8px 38px",
      "text-align": "left",
      "border-radius": "var(--radius)",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "NavigationView .selected": { "background": "var(--accent)", "color": "var(--accent-text)", "&:hover": { "background": "var(--accent-hover)" } },
    "NavigationView.compact .item": { "padding": "8px 19px" },
    "Stepper": { "flex-direction": "column", "gap": "16px", "color": "var(--text)" },
    "Stepper .steps": { "flex-direction": "row", "align-items": "center", "gap": "8px" },
    "Stepper .step": { "flex-direction": "row", "align-items": "center", "gap": "8px" },
    "Stepper .step-number": {
      "width": "24px",
      "padding": "3px 0px",
      "background": "var(--track)",
      "color": "var(--muted)",
      "border-radius": "999px",
      "text-align": "center",
      "font-weight": "bold",
    },
    "Stepper .step-title": { "color": "var(--muted)" },
    "Stepper .done .step-number": { "background": "var(--accent)", "color": "var(--accent-text)" },
    "Stepper .done .step-title": { "color": "var(--text)" },
    "Stepper .current .step-number": { "background": "var(--accent)", "color": "var(--accent-text)" },
    "Stepper .current .step-title": { "color": "var(--text)", "font-weight": "bold" },
    "Stepper .step-line": { "width": "32px", "height": "2px", "background": "var(--border)", "flex-shrink": "0" },
    "Stepper .step-line.done": { "background": "var(--accent)" },
    "Stepper .step-content": { "flex-direction": "column" },
    "Carousel": { "flex-direction": "column", "gap": "8px", "color": "var(--text)" },
    "Carousel .stage": { "flex-direction": "row", "align-items": "center", "gap": "8px" },
    "Carousel .viewport": { "flex-direction": "column", "flex-grow": "1", "min-width": "0px" },
    "Carousel .prev": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 12px",
      "border-radius": "999px",
      "flex-shrink": "0",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Carousel .next": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 12px",
      "border-radius": "999px",
      "flex-shrink": "0",
      "&:hover": { "background": "var(--track)" },
      "&:active": { "background": "var(--border)" },
    },
    "Carousel .dots": { "flex-direction": "row", "justify-content": "center", "gap": "6px" },
    "Carousel .dot": {
      "width": "8px",
      "height": "8px",
      "padding": "0px",
      "background": "var(--border)",
      "border-radius": "999px",
      "&:hover": { "background": "var(--muted)" },
    },
    "Carousel .dot.current": { "background": "var(--accent)" },
    "CheckBox": {
      "color": "var(--text)",
      "padding": "2px 2px 2px 26px",
      "indicator-background": "var(--surface)",
      "indicator-border-color": "var(--border)",
      "indicator-mark-color": "var(--accent-text)",
      "&:checked": { "indicator-background": "var(--accent)", "indicator-border-color": "var(--accent)" },
      "&:hover": { "indicator-border-color": "var(--accent-hover)" },
    },
    "RadioButton": {
      "color": "var(--text)",
      "padding": "2px 2px 2px 26px",
      "indicator-background": "var(--surface)",
      "indicator-border-color": "var(--border)",
      "indicator-mark-color": "var(--accent-text)",
      "&:checked": { "indicator-background": "var(--accent)", "indicator-border-color": "var(--accent)" },
      "&:hover": { "indicator-border-color": "var(--accent-hover)" },
    },
    "ToggleSwitch": {
      "color": "var(--text)",
      "padding": "2px 2px 2px 40px",
      "indicator-background": "var(--track)",
      "indicator-border-color": "var(--border)",
      "indicator-mark-color": "var(--accent-text)",
      "&:checked": { "indicator-background": "var(--accent)", "indicator-border-color": "var(--accent)" },
    },
    "TextBox": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "caret-color": "var(--text)",
      "placeholder-color": "var(--muted)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "NumberBox": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "caret-color": "var(--text)",
      "placeholder-color": "var(--muted)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "TextArea": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "caret-color": "var(--text)",
      "gutter-color": "var(--muted)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "PasswordBox": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "caret-color": "var(--text)",
      "placeholder-color": "var(--muted)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "TokenBox": {
      "flex-direction": "row",
      "align-items": "center",
      "gap": "6px",
      "width": "260px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "4px 6px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "&:focus-within": { "border-color": "var(--accent)" },
    },
    "TokenBox .token": {
      "flex-direction": "row",
      "align-items": "center",
      "gap": "2px",
      "padding": "1px 2px 1px 8px",
      "background": "var(--track)",
      "color": "var(--text)",
      "border-radius": "999px",
      "flex-shrink": "0",
    },
    "TokenBox .token-remove": {
      "background": "transparent",
      "color": "var(--muted)",
      "padding": "0px 6px",
      "&:hover": { "color": "var(--text)" },
    },
    "TokenBox .entry": { "flex-grow": "1", "min-width": "40px", "border-width": "0px", "padding": "2px 2px", "background": "transparent" },
    "SearchBox": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 28px 6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "caret-color": "var(--text)",
      "placeholder-color": "var(--muted)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "Tooltip": {
      "background": "var(--tooltip)",
      "color": "var(--tooltip-text)",
      "font-family": "var(--font-family)",
      "font-size": "12px",
      "padding": "10px 12px",
      "gap": "10px",
      "align-items": "center",
      "border-radius": "var(--radius)",
    },
    "Tooltip TextBlock": { "color": "var(--tooltip-text)" },
    "Tooltip .icon": { "width": "24px", "height": "24px", "color": "var(--tooltip-text)", "align-self": "start" },
    "Tooltip .body": { "flex-direction": "column", "gap": "2px" },
    "Tooltip .header-row": { "flex-direction": "row", "gap": "10px", "align-items": "center" },
    "Tooltip .text-row": { "flex-direction": "row", "gap": "10px", "align-items": "center" },
    "Tooltip .header": { "font-weight": "bold" },
    "Tooltip .description": { "max-width": "280px", "color": "var(--tooltip-muted)" },
    "Tooltip .shortcut": { "font-family": "var(--font-mono)", "font-size": "11px", "color": "var(--tooltip-muted)" },
    "ComboBox": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "ContextMenu": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "4px 0",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "selection-color": "var(--accent)",
      "selection-text-color": "var(--accent-text)",
      "separator-color": "var(--border)",
    },
    "TreeView": {
      "height": "160px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "selection-color": "var(--accent)",
      "selection-text-color": "var(--accent-text)",
      "indent": "16px",
      "&:focus": { "border-color": "var(--accent)" },
    },
    "ListView": {
      "height": "160px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "selection-color": "var(--accent)",
      "selection-text-color": "var(--accent-text)",
      "&:focus": { "border-color": "var(--accent)" },
    },
    "CheckedListBox": {
      "height": "160px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "selection-color": "var(--track)",
      "selection-text-color": "var(--text)",
      "check-color": "var(--accent)",
      "check-border-color": "var(--muted)",
      "check-mark-color": "var(--accent-text)",
      "&:focus": { "border-color": "var(--accent)" },
    },
    "Slider": {
      "height": "24px",
      "slider-track-color": "var(--track)",
      "slider-fill-color": "var(--accent)",
      "slider-thumb-color": "var(--surface)",
      "&:hover": { "slider-fill-color": "var(--accent-hover)" },
      "&:active": { "slider-fill-color": "var(--accent-active)" },
    },
    "ProgressBar": {
      "height": "8px",
      "background": "var(--track)",
      "border-radius": "4px",
      "bar-color": "var(--accent)",
    },
  },
}

{
  // The default Silo theme. Everything a Control looks like comes from the Tokens below, so a derived theme can
  // restyle the whole library by overriding them.
  "tokens": {
    "--font-family": "Segoe UI",
    "--font-mono": "Fira Code, Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace",
    "--font-size": "14px",
    "--surface": "#ffffff",
    "--text": "#1f2937",
    "--accent": "#3b82f6",
    "--accent-hover": "#2563eb",
    "--accent-active": "#1d4ed8",
    "--accent-text": "#ffffff",
    "--radius": "4px",
    "--border": "#9ca3af",
    "--track": "#e5e7eb",
    "--tooltip": "#1f2937",
    "--tooltip-text": "#f9fafb",
    "--tooltip-muted": "#9ca3af",
    "--muted": "#9ca3af",
  },
  "rules": {
    "Box": {
      "color": "var(--text)",
      "font-family": "var(--font-family)",
      "font-size": "var(--font-size)",
    },
    "Window": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "font-family": "var(--font-family)",
      "font-size": "var(--font-size)",
      "flex-direction": "column",
    },
    "TextBlock": { "color": "var(--text)" },
    "Button": {
      "background": "var(--accent)",
      "color": "var(--accent-text)",
      "padding": "6px 12px",
      "border-radius": "var(--radius)",
      "text-align": "center",
      "&:hover": { "background": "var(--accent-hover)" },
      "&:active": { "background": "var(--accent-active)" },
    },
    "CheckBox": {
      "color": "var(--text)",
      "padding": "2px 2px 2px 26px",
      "indicator-background": "var(--surface)",
      "indicator-border-color": "var(--border)",
      "indicator-mark-color": "var(--accent-text)",
      "&:checked": { "indicator-background": "var(--accent)", "indicator-border-color": "var(--accent)" },
      "&:hover": { "indicator-border-color": "var(--accent-hover)" },
    },
    "RadioButton": {
      "color": "var(--text)",
      "padding": "2px 2px 2px 26px",
      "indicator-background": "var(--surface)",
      "indicator-border-color": "var(--border)",
      "indicator-mark-color": "var(--accent-text)",
      "&:checked": { "indicator-background": "var(--accent)", "indicator-border-color": "var(--accent)" },
      "&:hover": { "indicator-border-color": "var(--accent-hover)" },
    },
    "ToggleSwitch": {
      "color": "var(--text)",
      "padding": "2px 2px 2px 40px",
      "indicator-background": "var(--track)",
      "indicator-border-color": "var(--border)",
      "indicator-mark-color": "var(--accent-text)",
      "&:checked": { "indicator-background": "var(--accent)", "indicator-border-color": "var(--accent)" },
    },
    "TextBox": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "caret-color": "var(--text)",
      "placeholder-color": "var(--muted)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "Tooltip": {
      "background": "var(--tooltip)",
      "color": "var(--tooltip-text)",
      "font-family": "var(--font-family)",
      "font-size": "12px",
      "padding": "4px 8px",
      "gap": "10px",
      "align-items": "center",
      "border-radius": "var(--radius)",
    },
    "Tooltip TextBlock": { "color": "var(--tooltip-text)" },
    "Tooltip .shortcut": { "font-family": "var(--font-mono)", "font-size": "11px", "color": "var(--tooltip-muted)" },
    "ComboBox": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "6px 8px",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "&:hover": { "border-color": "var(--accent-hover)" },
      "&:focus": { "border-color": "var(--accent)" },
    },
    "ContextMenu": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "padding": "4px 0",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "selection-color": "var(--accent)",
      "selection-text-color": "var(--accent-text)",
    },
    "ListView": {
      "height": "160px",
      "background": "var(--surface)",
      "color": "var(--text)",
      "border-width": "1px",
      "border-color": "var(--border)",
      "border-radius": "var(--radius)",
      "selection-color": "var(--accent)",
      "selection-text-color": "var(--accent-text)",
      "&:focus": { "border-color": "var(--accent)" },
    },
    "Slider": {
      "height": "24px",
      "slider-track-color": "var(--track)",
      "slider-fill-color": "var(--accent)",
      "slider-thumb-color": "var(--surface)",
      "&:hover": { "slider-fill-color": "var(--accent-hover)" },
      "&:active": { "slider-fill-color": "var(--accent-active)" },
    },
    "Separator": {
      "height": "1px",
      "background": "var(--border)",
      "margin": "6px 0",
    },
    "Expander": { "flex-direction": "column" },
    "Expander .expander-header": {
      "background": "var(--track)",
      "color": "var(--text)",
      "text-align": "left",
      "&:hover": { "background": "var(--border)" },
      "&:active": { "background": "var(--border)" },
    },
    "ProgressBar": {
      "height": "8px",
      "background": "var(--track)",
      "border-radius": "4px",
      "bar-color": "var(--accent)",
    },
  },
}
